# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: Docker postgres runs on host port 5433
DATABASE_URI=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/kingsforth_payload
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ── Payload CMS ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_SECRET=generate-a-strong-random-string-here

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Used by /api/make-admin?secret=YOUR_SETUP_SECRET to create the first admin
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SETUP_SECRET=generate-a-random-hex-string-here
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-strong-admin-password

# ── Resend (email sending) ────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...
# Verified sender — REQUIRED for emails to reach any inbox besides your own Resend account email.
# Steps: resend.com → Domains → Add Domain → add kingsforth.net → add DNS records → Verify
# Then set: RESEND_FROM_EMAIL=noreply@kingsforth.net
RESEND_FROM_EMAIL=noreply@kingsforth.net

# ── Stripe (fill in when ready) ───────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PostHog analytics (optional) ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App URL ───────────────────────────────────────────────────────────────────
# Change to your actual domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel Blob (media storage on Vercel) ─────────────────────────────────────
# Vercel project settings → Storage → Blob → Create store → copy token
# Leave blank when running Docker locally (uses local disk instead)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Vercel / Neon (production DB) ─────────────────────────────────────────────
# Replace DATABASE_URI above with your Neon connection string for Vercel:
# DATABASE_URI=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
