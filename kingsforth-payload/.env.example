# ── Database (use port 5433 when running postgres via docker-compose) ──
DATABASE_URI=postgresql://postgres:admin123@localhost:5433/kingsforth_payload

# ── Payload CMS ──
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── Stripe (optional, leave as-is until ready) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend email (optional) ──
RESEND_API_KEY=re_...

# ── PostHog analytics (optional) ──
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Security (production only) ──
# Set PAYLOAD_SECRET to a 32+ character random string: openssl rand -base64 32
# NODE_ENV=production  (set automatically by hosting platforms)
