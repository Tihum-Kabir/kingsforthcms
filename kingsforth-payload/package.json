{
  "name": "kingsforth-payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" payload generate:importmap && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next start",
    "swagger": "node swagger-server.cjs",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx src/seed/index.ts",
    "seed:services": "tsx src/seed/seed-services.ts",
    "seed:solutions": "tsx src/seed/seed-solutions.ts",
    "seed:resources": "tsx src/seed/seed-resources.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.84.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/three": "^0.183.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.38.0",
    "graphql": "^16.10.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "payload": "^3.84.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.10.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "eslint": "^9.25.0",
    "eslint-config-next": "15.4.11",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
